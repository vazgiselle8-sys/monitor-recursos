
[Unit]
Description=Monitor de Recursos GNU/Linux
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gisel
Group=gisel
WorkingDirectory=/var/www/html/monitor-recursos/backend
ExecStart=/usr/bin/node /var/www/html/monitor-recursos/backend/server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
